package-lock=true
; FIXME Set legacy-peer-deps=false when we upgrade RN.
legacy-peer-deps=true

; The build toolchain (webpack, sass, patch-package) lives in devDependencies,
; and `postinstall` runs patch-package. A host that exports NODE_ENV=production
; would make npm omit dev dependencies, breaking both `npm install` and
; `npm run build`, so ask for them explicitly.
include=dev
