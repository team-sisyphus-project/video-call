{
    "include": [ "**/*.ts", "./globals.d.ts" ],
    "compilerOptions": {
        "allowSyntheticDefaultImports": true,
        "esModuleInterop": true,
        "module": "commonjs",
        "target": "es2024",
        "lib": [ "ES2024", "DOM" ],
        "skipLibCheck": true,
        "moduleResolution": "node",
        "strict": true,
        "noImplicitAny": true,
        "resolveJsonModule": true,
        "moduleSuffixes": [ ".web", "" ]
    },
    "exclude": [ "node_modules" ]
}
